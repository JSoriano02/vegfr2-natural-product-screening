// nextflow.config

executor {
    // Aisla el entorno y confía en el programador del propio sistema operativo 
    name = 'local'
    
    // Límite estricto de RAM para proteger 4GB para el núcleo del sistema operativo 
    memory = '12 GB'
    
    // Contención térmica: limita el uso de la CPU para evitar estrangulamiento térmico 
    cpus = 6 
}

// Estrategia de resiliencia ante inestabilidades
process {
    errorStrategy = 'retry'
    maxRetries = 3

    // Embotellamiento asimétrico para procesos que usan la GPU (GNINA, ADMET-AI)
    withLabel: 'gpu_intensive' {
        maxForks = 1
    }
}